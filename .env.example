# Copy this file to `.env` and fill in your model.
# MODEL_NAME selects the provider + model for all LangChain agents
# (agent_react, agent_plan_execute, agent_hybrid all read it via models.py).
#
# --- Ollama Cloud (recommended for this project) ---
# 1. Create a key at https://ollama.com/settings/keys
# 2. Pick a cloud model name from https://ollama.com/api/tags
#    (use the API name, e.g. "gemma4:31b" -- NOT the "gemma4:cloud" CLI alias).
# Option A -- explicit Cloud routing via the OpenAI-compatible endpoint
# (https://docs.ollama.com/api/openai-compatibility). Works with no local install.
# MODEL_NAME=ollama-cloud:gpt-oss:120b
# OLLAMA_API_KEY=your_api_key_here
# Option B -- native Ollama path. Uses Ollama Cloud when OLLAMA_API_KEY is set,
# otherwise falls back to a local daemon at http://localhost:11434.
# MODEL_NAME=ollama:gpt-oss:120b
# OLLAMA_API_KEY=your_api_key_here
# Optional override (defaults to https://ollama.com/v1 for ollama-cloud:):
# OLLAMA_BASE_URL=https://ollama.com/v1
#
# --- Other providers (passthrough to LangChain init_chat_model) ---
# Format: "<provider>:<model>".
# Examples: "openai:gpt-4o-mini", "google_genai:gemini-2.0-flash", "anthropic:claude-haiku-4-5".
MODEL_NAME=ollama-cloud:gpt-oss:120b
OLLAMA_API_KEY=
